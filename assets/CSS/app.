* {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background:
                radial-gradient(circle at 15% 0%, rgba(212,175,55,0.07), transparent 28%),
                radial-gradient(circle at 85% 10%, rgba(197,168,128,0.06), transparent 24%),
                #18181B;
            color: #FAF9F6;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        ::selection {
            background: #D4AF37;
            color: #18181B;
        }

        .glass {
            background: rgba(39,39,42,0.76);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1px solid rgba(255,255,255,0.07);
        }

        .gold-border {
            border-color: rgba(212,175,55,0.38);
        }

        .luxury-gradient {
            background:
                linear-gradient(135deg, rgba(212,175,55,0.12), transparent 35%),
                linear-gradient(315deg, rgba(197,168,128,0.08), transparent 45%),
                #27272A;
        }

        .input-luxury {
            width: 100%;
            border: 1px solid rgba(255,255,255,0.09);
            background: rgba(24,24,27,0.78);
            color: #FAF9F6;
            border-radius: 12px;
            outline: none;
            transition: 0.2s ease;
        }

        .input-luxury:focus {
            border-color: rgba(212,175,55,0.65);
            box-shadow: 0 0 0 3px rgba(212,175,55,0.08);
        }

        .input-luxury::placeholder {
            color: #71717A;
        }

        .btn-gold {
            background: linear-gradient(135deg, #D4AF37, #C5A880);
            color: #18181B;
            transition: 0.2s ease;
        }

        .btn-gold:hover {
            transform: translateY(-1px);
            filter: brightness(1.06);
            box-shadow: 0 10px 30px rgba(212,175,55,0.18);
        }

        .btn-dark {
            background: #27272A;
            color: #FAF9F6;
            border: 1px solid rgba(255,255,255,0.08);
            transition: 0.2s ease;
        }

        .btn-dark:hover {
            background: #323236;
            border-color: rgba(212,175,55,0.3);
        }

        .product-card {
            transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
        }

        .product-card:hover {
            transform: translateY(-4px);
            border-color: rgba(212,175,55,0.26);
            box-shadow: 0 20px 50px rgba(0,0,0,0.22);
        }

        .product-image {
            transition: transform 0.5s ease;
        }

        .product-card:hover .product-image {
            transform: scale(1.035);
        }

        .product-rail { display:flex; gap:1.25rem; overflow-x:auto; overscroll-behavior-x:contain; scroll-snap-type:x mandatory; scrollbar-width:thin; padding:.15rem .1rem 1rem; -webkit-overflow-scrolling:touch; }
        .product-rail::-webkit-scrollbar { height:6px; }
        .product-rail::-webkit-scrollbar-thumb { background:rgba(212,175,55,.38); border-radius:999px; }
        .product-rail > .product-card { flex:0 0 min(82vw,330px); scroll-snap-align:start; }
        .catalog-rail-wrap { position:relative; }
        .rail-arrow { position:absolute; top:43%; z-index:20; width:42px; height:42px; border-radius:999px; display:flex; align-items:center; justify-content:center; background:rgba(24,24,27,.88); border:1px solid rgba(212,175,55,.3); color:#FAF9F6; box-shadow:0 10px 30px rgba(0,0,0,.35); transition:.2s ease; }
        .rail-arrow:hover { background:#D4AF37; color:#18181B; }
        .rail-arrow.left { left:-10px; } .rail-arrow.right { right:-10px; }
        .product-media { touch-action:pan-y; } .product-media img { user-select:none; -webkit-user-drag:none; }
        @media (max-width:640px) { .rail-arrow { display:none; } }

        .admin-sidebar{background:linear-gradient(180deg,rgba(39,39,42,.96),rgba(24,24,27,.98));}
        .admin-nav{transition:.2s ease;color:#a1a1aa;}
        .admin-nav:hover{background:rgba(212,175,55,.07);color:#faf9f6;border-color:rgba(212,175,55,.12);}
        .admin-nav.active{background:linear-gradient(135deg,rgba(212,175,55,.16),rgba(197,168,128,.05));color:#d4af37;border-color:rgba(212,175,55,.24);box-shadow:inset 3px 0 #d4af37;}
        .admin-kpi{background:linear-gradient(145deg,rgba(39,39,42,.98),rgba(28,28,31,.96));border:1px solid rgba(255,255,255,.06);}
        .admin-table-row:hover{background:rgba(255,255,255,.025);}
        .admin-chip{border:1px solid rgba(255,255,255,.07);background:rgba(255,255,255,.035);}
        .admin-mobile-nav{display:none;}
        @media(max-width:767px){.admin-mobile-nav{display:flex;overflow-x:auto;gap:.5rem;padding:.75rem 1rem;border-bottom:1px solid rgba(255,255,255,.05);}.admin-mobile-nav button{white-space:nowrap;}.admin-sidebar{display:none!important;}}

        .modal-backdrop {
            background: rgba(0,0,0,0.72);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }

        .drawer {
            transform: translateX(100%);
            transition: transform 0.3s ease;
        }

        .drawer.open {
            transform: translateX(0);
        }

        .modal-panel {
            animation: modalIn 0.22s ease-out;
        }

        @keyframes modalIn {
            from {
                opacity: 0;
                transform: scale(0.96) translateY(8px);
            }
            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        .login-panel {
            animation: loginIn 0.5s ease-out;
        }

        @keyframes loginIn {
            from {
                opacity: 0;
                transform: translateY(25px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .toast {
            transform: translateY(120px);
            opacity: 0;
            pointer-events: none;
            transition: 0.3s ease;
        }

        .toast.show {
            transform: translateY(0);
            opacity: 1;
            pointer-events: auto;
        }

        .stock-ready {
            color: #4ADE80;
            background: rgba(34,197,94,0.09);
            border-color: rgba(34,197,94,0.18);
        }

        .stock-low {
            color: #FACC15;
            background: rgba(234,179,8,0.09);
            border-color: rgba(234,179,8,0.18);
        }

        .stock-out {
            color: #F87171;
            background: rgba(239,68,68,0.09);
            border-color: rgba(239,68,68,0.18);
        }

        .quantity-input {
            appearance: textfield;
            -moz-appearance: textfield;
        }

        .quantity-input::-webkit-inner-spin-button,
        .quantity-input::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        .scrollbar-thin::-webkit-scrollbar {
            width: 5px;
        }

        .scrollbar-thin::-webkit-scrollbar-track {
            background: transparent;
        }

        .scrollbar-thin::-webkit-scrollbar-thumb {
            background: #52525B;
            border-radius: 20px;
        }

        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .hide-scrollbar {
            scrollbar-width: none;
        }

        .admin-sidebar {
            background:
                linear-gradient(180deg, rgba(212,175,55,0.08), transparent 25%),
                #202023;
        }

        .admin-nav.active {
            background: rgba(212,175,55,0.11);
            color: #D4AF37;
            border-color: rgba(212,175,55,0.18);
        }

        .variant-disabled {
            opacity: 0.45;
            pointer-events: none;
        }

        @media (max-width: 767px) {
            .mobile-hidden {
                display: none;
            }
        }

        .portal-nav-btn{transition:.2s ease;border:1px solid transparent}
        .portal-nav-btn:hover,.portal-nav-btn.active{background:rgba(212,175,55,.08);border-color:rgba(212,175,55,.18);color:#D4AF37}
        .workspace-panel{animation:panelIn .22s ease}
        @keyframes panelIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
        .modal-backdrop{background:rgba(0,0,0,.72);backdrop-filter:blur(12px)}

/* ============================================================
   BAYLOS MOBILE / SHOP LAYOUT FIX v2
   Mobile-first overrides: Android portrait is the primary layout.
   ============================================================ */

html, body { width:100%; max-width:100%; overflow-x:hidden; }
body { min-width:0; color:#FAF9F6; }
button, input, select, textarea { font:inherit; }

/* Prevent dashboard typography from inheriting browser black. */
#dashboardView, #ordersView, #catalogView, #adminView, #dashboardView * , #ordersView * {
  color-scheme: dark;
}
#dashboardView h1, #dashboardView h2, #dashboardView h3,
#ordersView h1, #ordersView h2, #ordersView h3 { color:#FAF9F6; }
#dashboardView .font-display, #ordersView .font-display { color:#FAF9F6; }
#dashboardView .bg-card, #ordersView .bg-card { color:#FAF9F6; }
#dashboardView .bg-card .font-display { color:#D4AF37; }
#dashCartItems, #dashOrders { color:#FAF9F6 !important; }

/* Dashboard cards are compact on phones. */
#dashboardView { width:100%; }
#dashboardView > .flex { margin-bottom:1.5rem; }
#dashboardView .grid { min-width:0; }
#dashboardView .rounded-2xl { min-width:0; }

/* Catalog uses a real product grid, not a giant horizontal rail. */
.product-rail {
  display:grid !important;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:.65rem;
  overflow:visible !important;
  padding:.1rem 0 1rem;
  scroll-snap-type:none;
}
.product-rail > .product-card {
  min-width:0;
  width:100%;
  flex:none !important;
  scroll-snap-align:none;
}
.product-card { min-width:0; border-radius:14px; }
.product-card:hover { transform:none; box-shadow:none; }
.product-card .product-media { aspect-ratio:1/1.08; }
.product-card .product-media > button[data-carousel] { width:28px; height:28px; }
.product-card .product-media > button[data-carousel] svg { width:14px; height:14px; }
.product-card .product-media .absolute.top-3 { top:.5rem; left:.5rem; right:.5rem; }
.product-card .product-media .absolute.bottom-3 { bottom:.5rem; left:.5rem; right:.5rem; }
.product-card .product-media [data-dots] { bottom:.55rem; }
.product-card > div:last-child { padding:.7rem; }
.product-card h3 { font-family:'Plus Jakarta Sans',sans-serif; font-size:.78rem; font-weight:700; line-height:1.25; color:#FAF9F6; }
.product-card > div:last-child > p { font-size:.65rem; margin-top:.18rem; }
.product-card > div:last-child .mt-5 { margin-top:.65rem; }
.product-card > div:last-child .space-y-2 { gap:.2rem; }
.product-card > div:last-child .text-lg { font-size:.85rem; }
.product-card > div:last-child .grid.gap-2 { gap:.35rem; margin-top:.7rem; }
.product-card > div:last-child .grid.gap-2 button { height:34px; border-radius:9px; font-size:.62rem; }
.product-card > div:last-child .grid.gap-2 svg { width:14px; height:14px; }
.product-card .stock-ready, .product-card .stock-low { font-size:8px; padding:.35rem .45rem; }
.product-card .product-media .bg-obsidian\/80 { background:rgba(24,24,27,.86); }

/* Catalog header/filter is compact and scroll-safe on Android. */
#catalogView main { width:100%; max-width:1600px; }
#catalogView .glass { max-width:100%; }
#catalogView .grid.grid-cols-1.lg\:grid-cols-\[1fr_auto_auto\] { grid-template-columns:1fr; }
#catalogView .input-luxury { min-width:0 !important; }
#catalogView .catalog-rail-wrap { width:100%; }
#catalogView .rail-arrow { display:none; }

/* Header controls never force horizontal overflow. */
header .max-w-\[1600px\] { min-width:0; }
header .flex.items-center.gap-2.sm\:gap-3 { min-width:0; }
#tierSelect { max-width:155px; }

/* Toast must stay above content but never cover the bottom navigation. */
#toast { z-index:9999; bottom:max(18px, env(safe-area-inset-bottom)); }
#toast .glass { background:rgba(24,24,27,.96); border-color:rgba(212,175,55,.16); }

@media (min-width:640px) {
  .product-rail { grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; }
  .product-card > div:last-child { padding:1rem; }
  .product-card h3 { font-size:.95rem; }
}

@media (min-width:1024px) {
  .product-rail { grid-template-columns:repeat(4,minmax(0,1fr)); gap:1.25rem; }
  .product-card .product-media { aspect-ratio:4/4.6; }
  .product-card > div:last-child { padding:1.15rem; }
  .product-card h3 { font-size:1rem; }
  .rail-arrow { display:flex !important; }
}

@media (min-width:1536px) {
  .product-rail { grid-template-columns:repeat(5,minmax(0,1fr)); }
}

@media (max-width:639px) {
  /* Compact Android portrait dashboard. */
  #dashboardView { padding:1.25rem .85rem 5rem; }
  #dashboardView h1 { font-size:2rem; line-height:1.08; }
  #dashboardView > .flex { gap:1rem; }
  #dashboardView > .flex > button { width:100%; justify-content:center; }
  #dashboardView > .grid.sm\:grid-cols-2 { grid-template-columns:repeat(2,minmax(0,1fr)); gap:.55rem; }
  #dashboardView > .grid.sm\:grid-cols-2 > .rounded-2xl { padding:.85rem; min-height:108px; }
  #dashboardView > .grid.sm\:grid-cols-2 .font-display { font-size:1.55rem; margin-top:.55rem; }
  #dashboardView > .grid.sm\:grid-cols-2 + .grid { grid-template-columns:1fr; gap:.65rem; }
  #dashboardView .grid.grid-cols-3 { gap:.4rem; }
  #dashboardView .grid.grid-cols-3 button { padding:.65rem; }

  /* Shop-style product spacing. */
  #catalogView main { padding-left:.75rem; padding-right:.75rem; padding-top:1rem; }
  #catalogView h1 { font-size:1.65rem; line-height:1.15; }
  #catalogView .mb-7 { margin-bottom:1rem; }
  #catalogView section.mb-8 { margin-bottom:1rem; }
  #catalogView section.mb-8 .flex.items-center.gap-3 { width:100%; overflow:hidden; }
  #catalogView section.mb-8 .flex.items-center.gap-3 > div { min-width:0; }
  #catalogView section.mb-8 .flex.items-center.gap-3 > div:first-child { display:none; }
  #catalogView section.mb-8 .flex.items-center.gap-3 > div { flex:1; }
  #catalogView section.mb-8 .flex.items-center.gap-3 > div p:last-child { white-space:nowrap; }
  #catalogView .glass.rounded-2xl { border-radius:12px; padding:.65rem; margin-bottom:1rem; }
  #catalogView .glass.rounded-2xl .input-luxury { height:42px; font-size:.75rem; }
  #catalogView .flex.items-center.justify-between.mb-5 { margin-bottom:.6rem; }
  #catalogView .flex.items-center.justify-between.mb-5 h2 { font-size:1.15rem; }
  #catalogView .flex.items-center.justify-between.mb-5 p { font-size:.65rem; }
}

@media (max-width:380px) {
  .product-rail { gap:.45rem; }
  .product-card > div:last-child { padding:.55rem; }
  .product-card h3 { font-size:.72rem; }
  .product-card > div:last-child .text-lg { font-size:.78rem; }
  #tierSelect { max-width:132px; font-size:.68rem; }
}
